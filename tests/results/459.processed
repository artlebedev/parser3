throwing:
	save refuses a uri: Exception: unsupported path scheme
	save refuses an invalid file://: Exception: must be file:///path or file://localhost/path
	delete refuses a uri: Exception: unsupported path scheme
	delete with exception(false) ignores a uri: silent
	delete with exception(false) ignores an invalid file://: silent
	find never finds a uri: not found
	find does not throw on an invalid file://: not found
	-f and -d do not throw on a uri or an invalid file://: no
	-f and -d accept file://: yes
backslash:
	save creates the directories: 459_tmp/b/c.txt
